# Sharon Online - Next.js server environment. Copy to .env.local (dev) or set in the host's secret store (prod).
# `next start` REFUSES to boot in production if the REQUIRED values below are missing/invalid (lib/server/config.ts).

# ---- REQUIRED in production ----
# Django API as seen from the Next.js server (never exposed to browsers; browsers only talk to /api/proxy).
INTERNAL_API_URL=http://localhost:8000/api/v1
# Public site URL (https in production). Anchors the CSRF same-origin allow-list.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# >= 32 random chars, NOT Django's SECRET_KEY. Signs the role/session cookie.  e.g.  openssl rand -base64 48
SESSION_SECRET=

# ---- Deployment tuning ----
# Reverse proxies in front of Next.js (0 = none). Sets which X-Forwarded-For entry is trusted for per-IP throttling.
TRUSTED_PROXY_COUNT=0
# Plain-http staging only. Never in production.
# SESSION_COOKIE_SECURE=false
# Single-host production-mode smoke test against a localhost API.
# ALLOW_LOCAL_UPSTREAM=1

# ---- Dev only (the production build/start REFUSES this) ----
# NEXT_PUBLIC_USE_MOCKS=true

# ---- Third-party placeholders: NOT WIRED YET (added with the phase that uses them; sandbox/test keys only) ----
# Phase 10 - PayPal JS SDK client id (public by design; the secret stays in the Django env)
# NEXT_PUBLIC_PAYPAL_CLIENT_ID=
# Phase 10 - PayFast is a server-side redirect; no browser key is needed. Merchant id/key/passphrase live in the Django env.
# Phase 12 - Zoom lessons use join URLs from the API; only needed if the Meeting SDK is embedded (public SDK key only, never the secret)
# NEXT_PUBLIC_ZOOM_SDK_KEY=
# Phase 13 - Sentry (browser + server error reporting)
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_AUTH_TOKEN=            # build-time source-map upload only; keep in CI secrets

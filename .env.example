# ==============================================================================
# Sharon's ESL Marketplace Platform - Environment Configuration Template
# ==============================================================================

# --- DJANGO CONFIGURATION ---
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=change-me-generate-a-unique-50+-char-random-value
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,backend
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=

# --- DATABASE CONFIGURATION ---
# Local Docker / Dev Postgres:
DATABASE_URL=postgresql://postgres:postgres@db:5432/esl_dev
# Staging/Production Neon Postgres (uncomment for production):
# DATABASE_URL=postgresql://user:password@ep-neon-frankfurt.eu-central-1.aws.neon.tech/esl_prod?sslmode=require

# --- CACHE & CELERY (REDIS) ---
# Local Docker / Dev Redis:
REDIS_URL=redis://redis:6379/0
# Staging/Production Upstash Redis (uncomment for production):
# REDIS_URL=rediss://default:password@upstash-frankfurt.upstash.io:6379

# --- NEXT.JS FRONTEND ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000
# DEV ONLY: serve built-in fixtures + demo logins when the backend is unreachable or errors. Never set in staging or
# production - `next build` / `next start` refuse to run with it. Leave unset to see real API errors.
# NEXT_PUBLIC_USE_MOCKS=true

# --- Frontend session (Task 8.4) ---
# Auth tokens live only in HttpOnly cookies set by the Next.js server; the browser calls /api/proxy/* and the server
# attaches the token. SESSION_SECRET signs the short-lived `sharon_session` cookie the middleware uses for role routing.
# It is a secret ONLY the Next.js server holds - never reuse Django's DJANGO_SECRET_KEY. Required (>=32 chars) in production.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
# Number of trusted reverse proxies in front of the Next.js server, so the real client IP (not the Next server) reaches
# Django's login/register throttles. 0 (default) = unknown. Django then needs THROTTLE_NUM_PROXIES=1 (Next is that proxy).
TRUSTED_PROXY_COUNT=0
# Cookies are Secure in production. Set to false ONLY for plain-http staging (e.g. docker compose on localhost).
# SESSION_COOKIE_SECURE=false
NODE_ENV=development

# --- THIRD-PARTY INTEGRATIONS ---
# --- DAILY.CO VIDEO CONFERENCING (Decision D-14 / Requirement R4) ---
# Daily.co REST API key (REQUIRED in production; used for room creation, tokens, presence)
DAILY_API_KEY=
# Daily domain or subdomain (e.g. sharonesl.daily.co or sharonesl; REQUIRED in production)
DAILY_DOMAIN=sharonesl.daily.co
# Daily webhook signing secret for HMAC-SHA256 signature verification (REQUIRED in production, >=16 chars)
DAILY_WEBHOOK_SECRET=
# Daily REST API base URL (defaults to https://api.daily.co/v1)
DAILY_API_BASE_URL=https://api.daily.co/v1
# Daily room & token validity window tuning (defaults: 15m before, 30m after end)
DAILY_ROOM_OPEN_MINUTES_BEFORE=15
DAILY_ROOM_VALID_AFTER_END_MINUTES=30
# Simulate Daily rooms without API calls (local dev/offline testing only; never true in production)
DAILY_SIMULATE_WITHOUT_CREDENTIALS=false

# Google Calendar OAuth (G1; use a versioned Fernet keyring, never plaintext refresh tokens)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/integrations/google-calendar/callback/
GOOGLE_OAUTH_STATE_TTL=600
INTEGRATION_DATA_KEYS='{}'
INTEGRATION_DATA_ACTIVE_KEY=

# Google Calendar API (v3):
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback/

# Resend Transactional Email (docs/NOTIFICATIONS.md). Only apps/integrations/services/email.py talks to Resend.
RESEND_API_KEY=re_dev_placeholder
RESEND_WEBHOOK_SECRET=
DEFAULT_FROM_EMAIL=Sharon ESL <bookings@sharonesl.com>
# Seconds before a Resend call counts as a timeout (the send is then 'retryable').
RESEND_TIMEOUT_SECONDS=10
# 'resend' (real API) or 'console' (Django prints the e-mail locally, tests collect it). Blank = 'resend' when
# RESEND_API_KEY is a real key, else 'console'. PRODUCTION REFUSES TO BOOT unless this resolves to 'resend'.
EMAIL_BACKEND_MODE=
# Notifications (slice N1a, docs/NOTIFICATIONS.md §2). Staff alerts (fulfilment failures, disputes without a verdict,
# undeliverable notification e-mails) go to these staff accounts: comma-separated e-mail addresses of ACTIVE staff / admin
# users (other addresses are ignored). Blank = every active admin-role user. Set it before go-live.
ADMIN_ALERT_RECIPIENTS=
# Delivery tuning (defaults shown): attempts before 'failed' + staff alert, 'sending' lease, first retry delay, backoff cap.
# NOTIFICATION_MAX_ATTEMPTS=8
# NOTIFICATION_LEASE_SECONDS=900
# NOTIFICATION_RETRY_SECONDS=60
# NOTIFICATION_RETRY_MAX_SECONDS=3600
# Base URL of the public site: every password-reset / verify-e-mail link is built from it (https in production).
FRONTEND_BASE_URL=http://localhost:3000

# Slot holds (Task 9.4): how long a started-but-unfinished payment keeps its slot, and the absolute cap per booking.
PAYMENT_INFLIGHT_GRACE_SECONDS=900
PAYMENT_HOLD_MAX_SECONDS=1800

# Power-outage reports are accepted only around the lesson (Task 9.7).
OUTAGE_REPORT_BEFORE_START_SECONDS=3600
OUTAGE_REPORT_AFTER_END_SECONDS=1800

# EskomSePush (periodic sync only; request handlers read cached status)
ESKOMSEPUSH_API_KEY=
ESKOMSEPUSH_BASE_URL=https://developer.sepush.co.za/business/2.0
ESKOMSEPUSH_TIMEOUT_SECONDS=10
ESKOMSEPUSH_FRESH_SECONDS=1800
ESKOMSEPUSH_STALE_SECONDS=86400

# PayFast (South Africa - ZAR):
PAYFAST_MERCHANT_ID=10000100
PAYFAST_MERCHANT_KEY=46f0cd694581a
PAYFAST_PASSPHRASE=jt7NOE43FZPn
PAYFAST_SANDBOX=True
PAYFAST_SKIP_IP_CHECK=False
PAYFAST_NOTIFY_URL=
# Buyer redirect after PayFast checkout; blank = FRONTEND_BASE_URL + /student/checkout/return|cancel. Production needs https, not localhost.
PAYFAST_RETURN_URL=
PAYFAST_CANCEL_URL=
# Reverse-proxy trust. Production REFUSES to boot unless these are >= 1 (or BEHIND_NO_PROXY=1 when exposed directly).
# THROTTLE_NUM_PROXIES: proxies in front of Django (so rate limits key on the real client IP, not a spoofed header).
# PAYFAST_TRUSTED_PROXY_COUNT: same, for PayFast's source-IP check (ITNs fail if this is wrong).
THROTTLE_NUM_PROXIES=0
PAYFAST_TRUSTED_PROXY_COUNT=0
# Extra allowed ITN source ranges (comma-separated CIDRs) - copy PayFast's currently published list; DNS is used too.
PAYFAST_EXTRA_ALLOWED_CIDRS=
# Production only: set to 1 for a deliberate staging deploy that still talks to the PayFast sandbox.
ALLOW_PAYMENT_SANDBOX_IN_PROD=
# EUR/JPY lesson checkout is blocked when the newest admin-entered FX rate is older than this many hours.
FX_RATE_MAX_AGE_HOURS=24
# Pending-payment grace (Task 10.2): circuit breaker for buyer-side pendings, and the overall ceiling for all open grace bookings.
GRACE_MAX_OPEN=5
GRACE_MAX_OPEN_TOTAL=15

# PayPal v2 Orders API (USD / EUR / JPY):
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
PAYPAL_WEBHOOK_ID=
# Ask PayPal to require immediate payment (no eCheck funding); leave False until the sandbox shows eCheck pendings
PAYPAL_REQUIRE_IMMEDIATE_PAYMENT=False
# Task 10.7 refunds: PayFast refunds stay disabled (manual) until the API is verified; the note is shown to the payer.
PAYFAST_REFUNDS_ENABLED=False
# Which backend returns refunds to students. Local/CI: the manual backend (moves no money; refunds wait for a person).
# PRODUCTION MUST USE: apps.payments.services.refund_gateways.RoutingRefundGateway (PayPal API; PayFast stays manual until enabled).
# Production refuses to boot on the manual backend (config/settings/guard.py) unless ALLOW_MANUAL_REFUNDS_IN_PROD=1.
REFUND_GATEWAY_BACKEND=apps.payments.services.refunds.ManualSandboxRefundGateway
# Production only: set to 1 for a deliberate staging deploy that keeps the manual refund backend.
ALLOW_MANUAL_REFUNDS_IN_PROD=
PAYPAL_REFUND_NOTE=Refund from Sharon Online

# Lesson fulfilment + T+10 room probe (Slice F0). The values shown are the defaults.
FULFILLMENT_MAX_ATTEMPTS=5
FULFILLMENT_LEASE_SECONDS=600
FULFILLMENT_RETRY_SECONDS=30
FULFILLMENT_RETRY_MAX_SECONDS=1800
FULFILLMENT_QUEUED_STALE_SECONDS=120
ATTENDANCE_PROBE_BUDGET_SECONDS=25

# Slice T2 (availability), PROVISIONAL until Anesu confirms (plan section 9). Defaults shown.
# BOOKING_HORIZON_DAYS replaces the old MAX_SLOT_DAYS / SLOT_HORIZON_DAYS / RESCHEDULE_MAX_DAYS_AHEAD.
BOOKING_HORIZON_DAYS=14
# A slot must start MORE than this many minutes away, when it is listed and again when it is paid for.
TUTOR_MIN_NOTICE_MINUTES=10

# Task 10.8 receipts: VAT included in prices, as a fraction (0.15 = 15%). 0 until D-12 (tax identity) is settled.
PLATFORM_VAT_RATE=0

# Payout batches (slices P1a-c). PROVISIONAL until D-3: balances below the minimum carry over; bank-detail changes hold payouts.
PAYOUT_MIN_ZAR=100
PAYOUT_BANK_CHANGE_HOLD_HOURS=72

# Tutor bookability + admin cancel (slice T1b, docs/TUTOR_STATUS_MACHINE.md). PROVISIONAL defaults shown.
# The training gate MUST be True before launch (production logs a warning while it is off).
TUTOR_TRAINING_GATE_ENABLED=False
ADMIN_CANCEL_BONUS_CREDITS=0
# Vetting rubric (slice T4a, PROVISIONAL until D-11): minimum score per criterion (1-5) and the uploads required to approve
# (comma separated: avatar, accent_audio, tefl_certificate, intro_video, identity_document; empty = none required).
VETTING_MIN_RUBRIC_SCORE=3
# Tutor application funnel (slice T5a, PROVISIONAL until D-11): uploads required to submit, minimum connection, test age.
APPLICATION_REQUIRED_ASSET_KINDS=avatar,accent_audio,intro_video,tefl_certificate,identity_document
APPLICATION_MIN_DOWNLOAD_MBPS=10
APPLICATION_MIN_UPLOAD_MBPS=5
APPLICATION_SPEED_TEST_MAX_AGE_HOURS=168
VETTING_REQUIRED_ASSET_KINDS=

# Tutor payout data encryption. JSON map of version to Fernet key; keep old versions during rotation.
# Generate a key with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PAYOUT_DATA_KEYS={"v1":"replace-with-a-generated-fernet-key"}
PAYOUT_DATA_ACTIVE_KEY=v1

# Cloudflare R2 Object Storage (Zero Egress):
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=esl-platform-assets
CLOUDFLARE_R2_PRIVATE_BUCKET_NAME=
CLOUDFLARE_R2_PUBLIC_DOMAIN=https://assets.sharonesl.com
# False refuses gateway checkout/capture (503); the frontend mirrors it with NEXT_PUBLIC_PAYMENTS_ENABLED. For deployed test environments.
PAYMENTS_ENABLED=true
# Development-only confirmation path; defaults on when PAYMENTS_ENABLED=false, but keep this explicit in deployed test environments.
TEST_BOOKINGS_ENABLED=false
